# Copy to .env:  cp frontend/.env.example frontend/.env
VITE_API_URL=http://localhost:8000
# Google OAuth client ID (same project as the backend's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=
# Optional: extra hostnames allowed to reach the Vite dev server (comma-separated).
# VITE_ALLOWED_HOSTS=my-pc.lan.example.com

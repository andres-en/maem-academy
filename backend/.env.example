# Copy to .env and adjust the values:  cp backend/.env.example backend/.env

# "development" allows the default secrets below. Any other value
# (e.g. "production") refuses to start with them.
ENVIRONMENT=development

# Database. docker-compose already injects DATABASE_URL into the backend
# container; this value is used when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://capacitador:capacitador@localhost:5432/capacitador_it

# Application JWT (issued after validating the Google sign-in).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Google OAuth client ID (Google Cloud Console). Required to sign in.
GOOGLE_CLIENT_ID=

# Allowed frontend origins (comma-separated).
CORS_ORIGINS=http://localhost:2309

# S3-compatible storage (MinIO in development).
# S3_ENDPOINT_URL: used by the backend (inside Docker) to talk to MinIO.
# S3_PUBLIC_URL: used to build URLs the browser can open.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=capacitador-it
S3_REGION=us-east-1
S3_USE_SSL=false
MAX_UPLOAD_SIZE_MB=200

# Only used by app/scripts/seed_initial_data.py to create the first SUPERADMIN.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=Administrator
